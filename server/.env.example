# 复制为 .env 后填写；.env 不要提交到仓库

# 服务端口
PORT=3000

# 监听地址：本地/真机调试用 0.0.0.0，生产建议 127.0.0.1（由 Nginx 反代）
HOST=0.0.0.0

# 微信小程序（mp 后台 → 开发管理 → 开发设置）
APPID=
APPSECRET=

# 登录态签名密钥，随便一段长随机字符串
AUTH_SECRET=

# 手动同步接口口令
ADMIN_TOKEN=

# 邀请码，逗号分隔；INVITE_LIMIT 是总使用次数上限
INVITE_CODES=CLASS2026
INVITE_LIMIT=50

# 每小时第几分钟同步
SYNC_MINUTE=5

# 本地开发：跳过微信校验，登录固定身份
# DEV_MODE=1
