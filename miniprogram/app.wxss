page {
  --color-primary: #FFA116;
  --color-primary-light: #FFF4E0;
  --text-main: #1F2329;
  --text-sub: #646A73;
  --text-weak: #8F959E;
  --line: #EFF0F1;
  --bg: #F7F8FA;
  --easy: #00AF9B;
  --medium: #FFB800;
  --hard: #FF2D55;
  background: var(--bg);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  /* button 元素默认带左右 padding 且宽度不撑满，这里统一重置 */
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  margin: 0 auto;
  border: none;
  background: var(--color-primary);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #E5E6EB;
  color: #A9AEB8;
}

.muted {
  color: var(--text-weak);
  font-size: 24rpx;
}
