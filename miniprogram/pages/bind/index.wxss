.label { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.input {
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 28rpx;
}
.ph { color: #B6BAC2; }
.link-tip { margin-top: 16rpx; color: var(--color-primary); }
.mt { margin-top: 32rpx; }
.center { display: block; text-align: center; margin-top: 20rpx; }
.error { color: var(--hard); font-size: 26rpx; margin-top: 20rpx; }

.preview-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.preview-body { display: flex; align-items: center; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: var(--line); }
.preview-meta { margin-left: 20rpx; }
.nickname { font-size: 30rpx; font-weight: 600; }
.diff { display: flex; gap: 24rpx; margin-top: 24rpx; font-size: 26rpx; }
.easy { color: var(--easy); }
.medium { color: var(--medium); }
.hard { color: var(--hard); }

.rules-title { font-size: 26rpx; font-weight: 600; color: var(--text-sub); margin-bottom: 12rpx; }
.rule { font-size: 24rpx; color: var(--text-weak); line-height: 1.8; }
