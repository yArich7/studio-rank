.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 56rpx;
  box-sizing: border-box;
  position: relative;
}

.brand { text-align: center; margin-bottom: 140rpx; }
.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 32rpx;
  border-radius: 28rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 128rpx;
  letter-spacing: 2rpx;
}
.title { font-size: 40rpx; font-weight: 700; margin-bottom: 12rpx; }
.sub { color: var(--text-weak); font-size: 26rpx; }

.actions { width: 100%; }

.btn-wechat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  margin: 0;
  padding: 0 32rpx;
  white-space: nowrap;
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-wechat::after { border: none; }
.btn-wechat[disabled] { background: #A8E2C4; color: #F0FBF4; }
.icon {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 16rpx;
}

.error {
  color: var(--hard);
  font-size: 24rpx;
  text-align: center;
  margin-top: 24rpx;
}

.agree {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  font-size: 24rpx;
  color: var(--text-weak);
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid #C9CDD4;
  border-radius: 6rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
  color: #fff;
}
.checkbox.checked { background: var(--color-primary); border-color: var(--color-primary); }
.link { color: var(--color-primary); }

.foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(56rpx + env(safe-area-inset-bottom));
  text-align: center;
  color: #B6BAC2;
  font-size: 22rpx;
}
