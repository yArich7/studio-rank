.center { text-align: center; }

.avatar-btn {
  display: block;
  padding: 0;
  margin: 0 auto;
  background: transparent;
  line-height: normal;
  width: 220rpx;
}
.avatar-btn::after { border: none; }
.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--line);
}
.badge {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}
.hint { margin-top: 20rpx; }

.label { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.input {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 12rpx;
  font-size: 30rpx;
}
.ph { color: #B6BAC2; }
.tip { margin-top: 16rpx; }
