.page { padding-bottom: 40rpx; }
.tip { text-align: center; padding: 24rpx; }

.grid { display: flex; flex-wrap: wrap; }
.cell { width: 50%; text-align: center; padding: 24rpx 0; }
.num { font-size: 56rpx; font-weight: 700; line-height: 1.2; }

.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }

.diff-row { display: flex; align-items: center; margin-bottom: 20rpx; }
.diff-label { width: 80rpx; font-size: 26rpx; }
.easy { color: var(--easy); }
.medium { color: var(--medium); }
.hard { color: var(--hard); }

.bar { flex: 1; height: 12rpx; background: var(--line); border-radius: 6rpx; overflow: hidden; }
.bar-inner { height: 100%; border-radius: 6rpx; }
.easy-bg { background: var(--easy); }
.medium-bg { background: var(--medium); }
.hard-bg { background: var(--hard); }
.diff-num { width: 70rpx; text-align: right; font-size: 26rpx; color: var(--text-sub); }

.empty { padding: 160rpx 48rpx; text-align: center; }
.empty-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty-btn { margin-top: 40rpx; }
