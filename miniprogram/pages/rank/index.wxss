.page { padding-bottom: 140rpx; }

.tabs {
  display: flex;
  background: #fff;
  padding: 8rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
  position: relative;
}
.tab-active {
  color: var(--color-primary);
  font-weight: 600;
}
.tab-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
}

.since {
  padding: 16rpx 32rpx;
  font-size: 22rpx;
  color: var(--text-weak);
  background: #FFF9EF;
}

.list { padding: 0 32rpx; }
.row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row-me { background: #FFF9EF; margin: 0 -32rpx; padding: 24rpx 32rpx; }

.rank {
  width: 56rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-weak);
  font-style: italic;
}
.rank-1 { color: #F5A623; }
.rank-2 { color: #9AA4B2; }
.rank-3 { color: #C08457; }

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: var(--line);
}
.info { flex: 1; min-width: 0; }
.nickname {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.score {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}
.unit { font-size: 22rpx; margin-left: 4rpx; font-weight: 400; }

.footer { text-align: center; padding: 8rpx 0 24rpx; }

.empty {
  padding: 160rpx 48rpx;
  text-align: center;
}
.empty-title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.empty-btn { margin-top: 40rpx; }

.mybar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
  backdrop-filter: blur(10rpx);
}
.mybar-left { color: var(--text-sub); }
.mybar-rank { flex: 1; margin-left: 16rpx; font-weight: 700; font-size: 32rpx; }
.mybar-score { color: var(--color-primary); font-weight: 700; }
