miniprogram_npm/
miniprogram/**/*.js.map

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# 临时文件
*.tgz
*.zip
project.private.config.json

# 截图（含个人昵称头像，不公开）
docs/screenshots/

# 本机专属配置（由 scripts/setup.mjs 生成）
config/app.config.json
project.config.json
miniprogram/config.local.ts
